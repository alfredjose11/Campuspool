SECRET_KEY=change-this-to-a-long-random-string
# Leave empty to use local SQLite. For Supabase paste its Postgres URI (postgresql://...).
DATABASE_URL=
# Empty = any email may sign up. Example to restrict: amaljyothi.ac.in
ALLOWED_DOMAINS=
# First admin account (created on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Email for OTP codes. If SMTP_HOST is empty the code is printed in the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=CampusPool <yourname@gmail.com>
# Set to 1 when the site runs on https
HTTPS=0
